# Copy this file to .env and fill in the values. Never upload .env to GitHub.

# Language of everything the bot writes in Discord: en (English) or cs (Czech).
# Without this line the bot stays Czech, which is what installs from before it existed rely on.
LANGUAGE=en
# Audio and subtitles in this language are chosen first (ISO 639 code, e.g. en, cs, sk, de, pl, fr, es).
# Without a track in it the film's default audio plays, with subtitles in this language if there are any.
PREFERRED_LANGUAGE=en
# Time zone (IANA name, e.g. Europe/London, America/New_York) for dates and for when a month starts in the statistics
TIMEZONE=Europe/Prague

# Token of the control bot (Discord Developer Portal -> your application -> Bot -> Reset Token)
BOT_TOKEN=

# Token of the user account that streams (selfbot)
STREAMER_TOKEN=

# Cinema channels (name or ID). Commands work only in the text channel, the stream goes to the voice channel.
TEXT_CHANNEL=filmsearch
VOICE_CHANNEL=film

# Server ID - may stay empty if the control bot is on one server only
GUILD_ID=

# Jellyfin address and API key (Jellyfin -> Dashboard -> API Keys)
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
# Jellyfin user under which the cinema saves what is half-watched and watched (empty = administrator)
JELLYFIN_USER=

# Path to ffmpeg ("ffmpeg" is enough if it is in PATH)
FFMPEG_PATH=ffmpeg
# Path to yt-dlp for YouTube and Kick links (empty = tools/yt-dlp.exe; the bot updates it by itself)
YTDLP_PATH=

# Video encoder: h264_qsv (Intel graphics), h264_nvenc (NVIDIA), libx264 (processor)
VIDEO_ENCODER=h264_qsv
# Stream quality (without Nitro max 720p / 30 fps)
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2500
AUDIO_BITRATE=128
# Hardware decoding: d3d11va (Windows), cuda (NVIDIA), vaapi (Linux), or 0 = processor
HW_DECODE=d3d11va

# After how many minutes without playback to leave the call
IDLE_LEAVE_MINUTES=5

# The "Want to watch" room: people write movie titles there, the bot looks them up and keeps a list.
# Needs a TMDB key (themoviedb.org -> Settings -> API) and Message Content Intent turned on in the Developer Portal.
WISHLIST_CHANNEL=filmy
TMDB_API_KEY=
# Optional: ratings straight from IMDb (omdbapi.com, free up to 1000 requests a day)
OMDB_API_KEY=
# Whom to ping when new films appear in Jellyfin (role ID or name; empty = no ping)
ANNOUNCE_ROLE=

# Only members with this role (ID or name) may control the cinema (empty = everyone)
ALLOWED_ROLE_ID=
