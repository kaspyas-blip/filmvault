# Zkopíruj tento soubor jako .env a vyplň hodnoty. Soubor .env nikdy nenahrávej na GitHub.

# Token ovládacího bota (Discord Developer Portal -> tvoje aplikace -> Bot -> Reset Token)
BOT_TOKEN=

# Token uživatelského účtu, který streamuje (selfbot)
STREAMER_TOKEN=

# Kanály kina (název nebo ID). Příkazy jdou jen v textovém, vysílá se do hlasového.
TEXT_CHANNEL=filmsearch
VOICE_CHANNEL=film

# ID serveru – stačí nechat prázdné, pokud je ovládací bot jen na jednom serveru
GUILD_ID=

# Adresa Jellyfinu a API klíč (Jellyfin -> Ovládací panel -> Klíče API)
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
# Uživatel Jellyfinu, pod kterým kino ukládá rozkoukané a zhlédnuté (prázdné = administrátor)
JELLYFIN_USER=

# Cesta k ffmpeg (stačí "ffmpeg", pokud je v PATH)
FFMPEG_PATH=ffmpeg

# Kódování videa: h264_qsv (Intel grafika), h264_nvenc (NVIDIA), libx264 (procesor)
VIDEO_ENCODER=h264_qsv
# Kvalita streamu (bez Nitra max 720p / 30 fps)
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2500
AUDIO_BITRATE=128
# Hardwarové dekódování: d3d11va (Windows), cuda (NVIDIA), vaapi (Linux), nebo 0 = procesor
HW_DECODE=d3d11va

# Po kolika minutách bez přehrávání se odpojit z hovoru
IDLE_LEAVE_MINUTES=5

# Roomka "Chceme vidět": sem lidi píšou filmy, bot je dohledá a vede seznam.
# Potřebuje TMDB klíč (themoviedb.org -> Settings -> API) a v Developer Portalu zapnutý Message Content Intent.
WISHLIST_CHANNEL=filmy
TMDB_API_KEY=
# Volitelné: hodnocení přímo z IMDb (omdbapi.com, zdarma do 1000 dotazů denně)
OMDB_API_KEY=
# Koho označit, když v Jellyfinu přibudou nové filmy (ID nebo název role; prázdné = bez označení)
ANNOUNCE_ROLE=test

# Jen členové s touto rolí (ID nebo název) smí ovládat kino (prázdné = všichni)
ALLOWED_ROLE_ID=
